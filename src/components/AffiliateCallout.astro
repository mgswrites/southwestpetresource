---
interface Props {
  label?: string;
  copy?: string;
  href?: string;
}
const {
  label = '🎒 Gear pick',
  copy = 'Heading out with your pet? This portable pet water dispenser is a handy pick for hikes, road trips, and campsites.',
  href = 'https://amzn.to/4vT4Elx',
} = Astro.props as Props;
---

<div class="panel affiliate-callout">
  <p class="callout-label">{label}</p>
  <p class="callout-copy">{copy}</p>
  <a href={href} class="callout-link" target="_blank" rel="nofollow sponsored noopener">Check it out on Amazon →</a>
  <p class="disclosure">As an Amazon Associate, we earn from qualifying purchases.</p>
</div>

<style>
  .affiliate-callout {
    max-width: 420px;
  }
  .callout-label {
    margin: 0 0 0.35rem;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--sage-dark);
  }
  .callout-copy {
    margin: 0 0 0.75rem;
    font-size: 0.92rem;
    color: var(--text);
  }
  .callout-link {
    display: inline-block;
    padding: 0.42rem 0.9rem;
    background: var(--sage-dark);
    color: #fff;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    transition: background 0.12s;
  }
  .callout-link:hover { background: var(--sage); text-decoration: none; }
  .disclosure {
    margin: 0.6rem 0 0;
    font-size: 0.75rem;
    color: var(--muted);
  }
</style>
