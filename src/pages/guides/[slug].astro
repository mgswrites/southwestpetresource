---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AffiliateCallout from '../../components/AffiliateCallout.astro';
import { getGuideBySlug, getGuides } from '../../lib/data';

export async function getStaticPaths() {
  const guides = await getGuides();
  return guides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}

const { guide } = Astro.props;
const entry = (await getGuideBySlug(guide.slug)) ?? guide;
---

<BaseLayout title={entry.title} description={entry.excerpt}>
  <div class="guide-banner">
    <img src={entry.image} alt="" class="banner-img" />
    <div class="banner-overlay" />
    <div class="banner-text">
      <h1>{entry.title}</h1>
      <p>{entry.excerpt}</p>
    </div>
  </div>

  <section class="section guide-body">
    <Fragment set:html={entry.body} />
  </section>

  {entry.slug === 'tips-traveling-with-pets-southwest' && (
    <section class="section">
      <AffiliateCallout
        label="🩹 Safety pick"
        copy="Every pet owner should have one of these on hand. A compact first-aid kit for dogs and cats, ready for the trail, the car, or home."
        href="https://amzn.to/4vSsRZ5"
      />
    </section>
  )}
</BaseLayout>

<style>
  .guide-banner {
    position: relative;
    width: calc(100% + 2.5rem);
    margin: -1rem -1.25rem 0;
    height: 300px;
    overflow: hidden;
  }
  .banner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  .banner-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.72) 0%, rgba(0,0,0,0.2) 55%, rgba(0,0,0,0.05) 100%);
  }
  .banner-text {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 2rem 1.5rem;
    color: #fff;
  }
  .banner-text h1 { margin: 0 0 0.4rem; font-size: 1.9rem; color: #fff; line-height: 1.25; }
  .banner-text p { margin: 0; opacity: 0.9; font-size: 0.95rem; }
</style>
